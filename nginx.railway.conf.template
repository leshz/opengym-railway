# openGym — Railway single-container web server.
#
# Serves the static SPA AND proxies /api to the API running alongside it in this same
# container, so the whole app lives on ONE origin (required for WebAuthn / passkeys).
#
# Differs from upstream web/nginx.conf in exactly two ways:
#   1. listen ${PORT}  — Railway assigns the port at runtime (envsubst'd by the entrypoint)
#   2. proxy_pass to 127.0.0.1  — same container here, not a separate compose service
server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # API → node process in this container
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # App shell: always revalidate so updates show up immediately
    location ~* \.(js|css|json|html)$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Static assets never change → cache hard
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_vary on;
    gzip_min_length 1024;
}
